  "quality": {
    "serving_prompts_are_not_vbench": true,
    "paired_prompts_per_model_minimum": 32,
    "paired_seeds": [
      301,
      302,
      303
    ],
    "vbench_repository": "https://github.com/Vchitect/VBench",
    "vbench_revision": "1039fe66d7aa2f4b214003ca2d35f5011c48bfee",
    "official_protocol": "complete pinned dimension/prompt manifest; 5 seeds, temporal flickering 25; no replacement with VidProM"
  },
  "sources": [
    "https://huggingface.co/Wan-AI/Wan2.1-T2V-1.3B-Diffusers",
    "https://huggingface.co/Wan-AI/Wan2.2-TI2V-5B-Diffusers",
