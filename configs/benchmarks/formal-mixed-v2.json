{
  "schema": "ditserve.formal-protocol.v2",
  "id": "formal-mixed-v2",
  "scope": "GenServe/TetriServe-aligned mixed-modality serving protocol: per-resolution unoptimized SP1 end-to-end latency SLO baseline, SLO scale [1.0, 1.5, 2.0], rate scale [0.5, 1.0, 1.5] relative to R0 (reported in req/min), 100 requests/trace, 81-frame 3-tier video (256p/480p/720p) and 3-tier image (512^2/1024^2/1440^2), video fractions [0.2, 0.5, 0.8], uniform and TetriServe exponential-skewed resolution distributions",
  "primary_model": "wan22",
  "sensitivity_models": [
    "wan21"
  ],
  "dataset_split": {
    "method": "sha256-normalized-prompt-bucket-v1",
    "salt": "ditserve-formal-20261102",
    "buckets": {
      "development": [
        0,
        20
      ],
      "calibration": [
        20,
        40
      ],
      "test": [
        40,
        100
      ]
    }
  },
  "datasets": {
    "image": {
      "kind": "diffusiondb",
      "repository": "https://huggingface.co/datasets/poloclub/diffusiondb",
      "revision": "fb620fbe49fa4420e0734bd9c0df11f51176b61f",
      "sha256": "eecd341187bc91c07f5994ad0660d40228ea025616fd57a509bef8323677c68f"
    },
    "video": {
      "kind": "vidprom",
      "repository": "https://huggingface.co/datasets/WenhaoWang/VidProM",
      "revision": "0c0900e6a037b058b1903bc1de9bcb6037d9fc24",
      "sha256": "7668b87803b67638fa899b69f3a2a298ea13daffe508ce625e21937bff958b6e"
    }
  },
  "seeds": {
    "development": [
      201,
      202,
      203
    ],
    "calibration": [
      101
    ],
    "test": [
      301,
      302,
      303,
      304,
      305
    ]
  },
  "requests_per_cell": {
    "development": 40,
    "test": 100
  },
  "video_fractions": [
    0.2,
    0.5,
    0.8
  ],
  "patterns": [
    {
      "name": "poisson"
    },
    {
      "name": "gamma",
      "cv": 2.0
    },
    {
      "name": "bursty",
      "bursts": 2,
      "burst_active_fraction": 0.25
    }
  ],
  "loads": [
    0.5,
    1.0,
    1.5
  ],
  "rate_definition": "R0 = slots * 60000 / mean_sp1_gpu_service_ms (req/min); offered rate_rpm = load * R0",
  "slo": {
    "video_scale": 1.5,
    "image_scale": 1.5,
    "scales": [
      1.0,
      1.5,
      2.0
    ],
    "default_scale": 1.5,
    "target_attainment_per_modality": 0.95,
    "basis": "per-shape measured SP1 end-to-end service (unoptimized single-GPU batch=1 including CPU text encoding and VAE decoding), frozen across all policies"
  },
  "resolution_distributions": [
    {
      "name": "uniform",
      "alpha": 0.0
    },
    {
      "name": "skewed",
      "alpha": 1.0,
      "formula": "p_i proportional to exp(alpha * L_i / L_max), L_i = ((frames - 1) // 4 + 1) * (height / 16) * (width / 16)"
    },
    {
      "name": "skewed_small",
      "alpha": -1.0,
      "formula": "p_i proportional to exp(alpha * L_i / L_max)"
    }
  ],
  "anchor": {
    "model": "wan22",
    "slo_scale": 1.5,
    "load": 1.0,
    "video_fraction": 0.5,
    "resolution_distribution": "uniform",
    "pattern": "poisson",
    "count": 100
  },
  "batch_limit": 1,
  "shape_distribution": "uniform or TetriServe exponential-skewed over latent token length within modality, deterministic largest-remainder integer quota",
  "shapes": {
    "wan21-dev": {
      "model": "wan21",
