  "prior_exposure": {
    "manifest_file": "known-exploration-prompts-v1.json",
    "manifest_sha256": "19edbc0cde6a27bf9e6203e8e0525e37298139e64c0450efa618fb69d8daa7cf",
    "also_exclude_existing_pool_roles": [
      "dev",
      "development"
    ],
    "scope": "Excludes all known local exploration and all source-pool dev prompts; unknown prior exposure is not ruled out"
  },
  "p0_diagnostics": {
    "scope": "Development execution-correctness stress only; not formal benchmark performance or scheduler utility evidence",
    "contention": {
      "count": 40,
      "video_fraction": 0.5,
      "pattern": "bursty",
      "load": 1.2,
      "image_slo_scale": 1.1,
      "video_slo_scale": 1.5,
      "lazy_preemption": false,
      "require_observed_stops": true
    },
    "no_preemption": {
      "count": 40,
      "video_fraction": 1.0,
      "pattern": "poisson",
      "load": 0.1,
      "image_slo_scale": 2.5,
      "video_slo_scale": 1.5,
      "lazy_preemption": true,
      "require_observed_stops": false
    },
    "acceptance": "native_exact requires actual positive stop evidence for contention and exactly zero for no_preemption; no automatic retry, threshold tuning, or qualification from intended pressure"
  },
  "baseline_comparison_contract": {
    "mode": "in_framework_policy_comparison",
    "shared_executor": true,
    "comparison_mode": "same_executor_mechanism_comparison",
    "statement": "All policies execute on the same verified DitServe native runtime, worker pool, SP/CFG collective transport, and calibrated latency profile to isolate scheduling mechanisms (EDF-CFG2, optimal Static-<Form>, CFG2-First, TetriServe-policy, SBP-ESP, EDF-BF vs. DitServe) on the Wan + SD3.5 mixed-workload main table.",
    "main_table_policies": [
      "edf-cfg2",
      "static-cfg2sp4",
      "cfg2-first",
      "tetriserve",
      "sbp-esp",
      "edf-bestfit",
      "ditserve"
    ],
    "best_static_form_rule": "select best calibrated Static-<Form> (default static-cfg2sp4 on 8xA100)",
    "candidate_static_forms": [
      "static-cfg2sp2",
      "static-cfg2sp3",
      "static-cfg2sp4"
    ],
    "mechanism_labels": {
      "edf-cfg2": "EDF-CFG2",
      "static-cfg2sp2": "Static-CFG2SP2",
      "static-cfg2sp3": "Static-CFG2SP3",
      "static-cfg2sp4": "Static-<Form>",
      "cfg2-first": "CFG2-First",
      "tetriserve": "TetriServe-policy",
      "sbp-esp": "SBP-ESP",
      "edf-bestfit": "EDF-BF",
      "ditserve": "DitServe"
    },
    "external_native_intersection": {
      "tetriserve": {
        "system": "TetriServe (ASPLOS'26)",
        "native_intersection_scope": "SD3.5-Medium single-modality multi-resolution (512^2 / 1024^2)",
        "shapes": [
          "sd35-512",
          "sd35-1024"
        ],
        "role": "external native runtime validation on supported image intersection"
      },
      "xdit": {
        "system": "xDiT",
        "native_intersection_scope": "single-model fixed partition/SP scaling (Wan2.1, Wan2.2, SD3.5)",
        "role": "external native engine validation under fixed partition / static CFG2xSP"
      }
    }
  },
  "quality_acceptance_contract": {
    "same_parallelism_segmentation_gate": {
      "mode": "strict_numerical_equivalence",
      "scope": "continuous vs. sub-step block-segmented execution under identical parallel form and group",
      "atol": 1e-05,
      "rtol": 1e-05,
      "bitwise_digest_when_deterministic": true
    },
    "cross_sp_acceptance_gate": {
      "mode": "semantic_quality_equivalence",
      "scope": "cross-SP / elastic degree transitions (SP1 vs. CFG2 vs. CFG2xSP2/3/4) where non-associative BF16 All-to-All reduction order differs",
      "disallow_strict_1e5_elementwise_gate": true,
      "metrics": [
        "PSNR",
        "SSIM",
        "LPIPS",
        "VBench"
      ],
      "numerical_drift_bound": "bounded BF16 collective reduction drift with semantic quality equivalence (PSNR/SSIM/LPIPS/VBench) instead of 1e-5 elementwise equality"
    }
  }
}
