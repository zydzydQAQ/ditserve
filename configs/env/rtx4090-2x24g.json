{
  "schema": "ditserve.env.v1",
  "name": "rtx4090-2x24g",
  "description": "Two RTX 4090 24GB cards. NCCL_P2P_DISABLE=1 routes collectives through host memory. Local SP1 costs for 17/33-frame 480p Wan and Sana 1024 are measured on physical GPU 1; two-GPU all-to-all links are measured under exclusive access. Wan/Sana memory fractions 0.54/0.40 and expandable segments passed dual-GPU acceptance. See docs/rtx4090-local.md for driver and validation scope.",
  "gpus": {
    "count": 2,
    "name_contains": "RTX 4090",
    "min_memory_mib": 23000
  },
  "models_root": "/models",
  "models": {
    "wan2.1-t2v-1.3b": {
      "path": "wan2.1-t2v-1.3b",
      "model_id": "Wan-AI/Wan2.1-T2V-1.3B-Diffusers",
      "revision": "0fad780a534b6463e45facd96134c9f345acfa5b"
    },
    "sana-sprint-0.6b": {
      "path": "sana-sprint-0.6b",
      "model_id": "Efficient-Large-Model/Sana_Sprint_0.6B_1024px_diffusers",
      "revision": "aa76e7f4f4928f378716b6716a2130fba3caf5b1"
    }
  },
  "worker_environment": {
    "OMP_NUM_THREADS": "8",
    "MKL_NUM_THREADS": "8",
    "OPENBLAS_NUM_THREADS": "8",
    "TOKENIZERS_PARALLELISM": "false",
    "NCCL_P2P_DISABLE": "1",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
  },
  "backends": {
    "wan": {
      "attention": "flash",
      "memory_fraction": 0.54
