{
  "schema": "ditserve.env.v1",
  "name": "rtx4090-2x24g",
  "description": "Two RTX 4090 24GB consumer cards. No GPU peer-to-peer, so NCCL stages through host memory (host_staged links until collectives are measured). Wan and Sana share each card under per-process caps: on the A100 the 480p Wan worker peaked at 11.4 GiB allocated and Sana at 8.2 GiB; capped to 12.95 and 9.6 GiB with expandable segments they reserved at most 12.85 and 8.55 GiB at unchanged speed (results/a100-as-24g-cost-profile/emu01). Re-check with the cost_profile study here, then fill cost_profile before serving runs.",
  "gpus": {
    "count": 2,
    "name_contains": "RTX 4090",
    "min_memory_mib": 23000
  },
  "models_root": "/models",
  "models": {
    "wan2.1-t2v-1.3b": {
      "path": "wan2.1-t2v-1.3b",
      "model_id": "Wan-AI/Wan2.1-T2V-1.3B-Diffusers",
      "revision": "0fad780a534b6463e45facd96134c9f345acfa5b"
    },
    "sana-sprint-0.6b": {
      "path": "sana-sprint-0.6b",
      "model_id": "Efficient-Large-Model/Sana_Sprint_0.6B_1024px_diffusers",
      "revision": "aa76e7f4f4928f378716b6716a2130fba3caf5b1"
    }
  },
  "worker_environment": {
    "OMP_NUM_THREADS": "8",
    "MKL_NUM_THREADS": "8",
    "OPENBLAS_NUM_THREADS": "8",
    "TOKENIZERS_PARALLELISM": "false",
    "NCCL_P2P_DISABLE": "1",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
  },
  "backends": {
    "wan": {
      "attention": "flash",
      "memory_fraction": 0.54
    },
    "sana": {
      "memory_fraction": 0.4
    }
  },
  "cost_profile": null,
