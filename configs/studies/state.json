{
  "schema": "ditserve.study.v1",
  "experiment": "cache-state",
  "note": "演示cache-off整步hot/cold快照；当前不产生缓存近似。需研究cache cold-anchor时显式启用cache并保留独立轨迹/质量评测。",
  "workers": {
    "model": {
      "backend": "wan",
      "python": "python3",
      "gpu_uuid": "GPU-REPLACE-WITH-FULL-DEVICE-UUID",
      "config": {
        "model_path": "/models/wan",
        "device": "cuda:0",
        "options": {}
      }
    }
  },
  "budget": {
    "limit_gpu_seconds": 600,
    "watchdog_seconds": 300,
    "repair_reserve_gpu_seconds": 0,
    "carry": "none"
  },
  "phases": [
    {
      "id": "roundtrip",
      "kind": "state",
      "generator": {
        "count": 2,
        "spec": {
          "prompt": "A red ceramic kettle on a wooden table.",
          "seed": 7,
          "steps": 20,
          "height": 480,
          "width": 832,
          "frames": 17,
          "guidance_scale": 5.0,
          "cache": false,
          "threshold": 0.0,
          "max_continuous": 1
        }
      },
      "transitions": [
        {
          "at_step": 5,
          "mode": "hot"
        },
        {
          "at_step": 10,
          "mode": "cold"
        }
      ],
      "artifact_dependencies": [
        "trajectory_and_output_evaluation"
      ]
    }
  ]
}
