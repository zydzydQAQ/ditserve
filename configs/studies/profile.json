{
  "schema": "ditserve.study.v1",
  "experiment": "profile",
  "note": "固定Wan2.1 T2V1.3B与UniPC配方；torch2.10.0+cu126、diffusers0.36.0、cache-dit1.5.0。配对仅控制相同输入，独立质量证据仍需另行评测。",
  "workers": {
    "model": {
      "backend": "wan",
      "python": "python3",
      "gpu_uuid": "GPU-REPLACE-WITH-FULL-DEVICE-UUID",
      "config": {
        "model_path": "/models/wan",
        "device": "cuda:0",
        "options": {}
      }
    }
  },
  "budget": {
    "limit_gpu_seconds": 600,
    "watchdog_seconds": 300,
    "repair_reserve_gpu_seconds": 0,
    "carry": "none"
  },
  "phases": [
    {
      "id": "paired",
      "kind": "profile",
      "paired": true,
      "generator": {
        "count": 2,
        "spec": {
          "prompt": "A red ceramic kettle on a wooden table.",
          "seed": 7,
          "steps": 20,
          "height": 480,
          "width": 832,
          "frames": 17,
          "guidance_scale": 5.0,
          "cache": false,
          "threshold": 0.0,
          "max_continuous": 1
        }
      },
      "matrix": {
        "/worker_config/attention": [
          "math",
          "efficient"
        ]
      },
      "artifact_dependencies": [
        "independent_quality_evaluation"
      ]
    }
  ]
}
